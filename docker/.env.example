# Kikonnect server configuration. Copy to `.env` (next to docker-compose.yml).
# Every value below is optional; the defaults are shown.

# --- docker compose only -----------------------------------------------------
# Host directory with fullchain.pem and privkey.pem (e.g. /etc/letsencrypt/live/tunnel.example.com).
# It is mounted read-only at /certs. Note: with Let's Encrypt the files in `live/` are symlinks
# into `../../archive`; mount /etc/letsencrypt itself and point KIKONNECT_CERT / KIKONNECT_KEY
# at /certs/live/<domain>/... in that case.
CERT_DIR=./certs
# UDP port published on the host.
KIKONNECT_PUBLIC_PORT=7000
# Image to run (published on tags v*).
# KIKONNECT_IMAGE=ghcr.io/kikonnect/kikonnect-server:latest

# --- server ------------------------------------------------------------------
# UDP address to listen on inside the container.
KIKONNECT_LISTEN=0.0.0.0:7000
# PEM certificate chain and private key (paths inside the container).
KIKONNECT_CERT=/certs/fullchain.pem
KIKONNECT_KEY=/certs/privkey.pem
# Log output: json or text.
KIKONNECT_LOG_FORMAT=json
# Log filter (tracing EnvFilter syntax), e.g. info, debug, kikonnect_server=debug.
KIKONNECT_LOG=info

# Limits
KIKONNECT_MAX_TUNNELS=500
KIKONNECT_MAX_PLAYERS_PER_TUNNEL=32
KIKONNECT_MAX_UDP_SESSIONS_PER_TUNNEL=1024
KIKONNECT_MAX_STREAMS_PER_CONNECTION=256
KIKONNECT_MAX_CONNECTIONS=10000

# Timeouts (seconds)
KIKONNECT_UDP_SESSION_TIMEOUT=60
KIKONNECT_NAME_GRACE_PERIOD=60

# Rate limit for Register/Join per source IP: burst size and attempts per minute (0 = off).
KIKONNECT_RATE_LIMIT_BURST=10
KIKONNECT_RATE_LIMIT_PER_MINUTE=30
